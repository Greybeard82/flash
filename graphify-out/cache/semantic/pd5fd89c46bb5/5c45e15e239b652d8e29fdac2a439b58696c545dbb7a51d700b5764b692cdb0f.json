{"nodes": [{"id": "files_prompt_ux_pass_01", "label": "PROMPT-UX-PASS-01.md (files root)", "file_type": "document", "source_file": "files/PROMPT-UX-PASS-01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ux_pass_01_unread_counts_model", "label": "UnreadCounts value object", "file_type": "code", "source_file": "files/PROMPT-UX-PASS-01.md", "source_location": "A1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ux_pass_01_loading_controller", "label": "LoadingController", "file_type": "code", "source_file": "files/PROMPT-UX-PASS-01.md", "source_location": "A2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ux_pass_01_resume_refresh_policy", "label": "ResumeRefreshPolicy", "file_type": "code", "source_file": "files/PROMPT-UX-PASS-01.md", "source_location": "A3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ux_pass_01_summary_source", "label": "SummarySource (Flutter)", "file_type": "code", "source_file": "files/PROMPT-UX-PASS-01.md", "source_location": "A4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ux_pass_01_cross_tab_unread_counts_live", "label": "B1 \u2014 Cross-Tab Unread Counts Update Live", "file_type": "rationale", "source_file": "files/PROMPT-UX-PASS-01.md", "source_location": "B1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optimistic updates applied at every read-state mutation site so badges update without a full reload; a 150ms-debounced unawaited authoritative re-query self-heals arithmetic drift, avoiding a per-scroll-frame synchronous re-query."}, {"id": "ux_pass_01_bigger_folder_tabs", "label": "B2 \u2014 Bigger Folder Tabs", "file_type": "concept", "source_file": "files/PROMPT-UX-PASS-01.md", "source_location": "B2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ux_pass_01_global_loading_indicator", "label": "B3 \u2014 Global Loading Indicator", "file_type": "rationale", "source_file": "files/PROMPT-UX-PASS-01.md", "source_location": "B3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every user-initiated or view-changing async operation shows a shared top-edge progress bar via LoadingController.run(), which fades in after 150ms to avoid flashing on instant operations and fades out on completion or error; additive to, not a replacement for, existing local spinners."}, {"id": "ux_pass_01_resume_refresh_wiring", "label": "B4 \u2014 Refresh Article List on App Resume", "file_type": "rationale", "source_file": "files/PROMPT-UX-PASS-01.md", "source_location": "B4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resume fetch runs with coldStart:false explicitly to avoid cleanup deleting read articles mid-session, preserving PRD \u00a74.3 list-persistence guarantee; scroll offset restore is accepted as imperfect since new articles insert above the current position."}, {"id": "ux_pass_01_tier_c_ai_summary", "label": "Tier C \u2014 AI Summary Reads Whole Article", "file_type": "rationale", "source_file": "files/PROMPT-UX-PASS-01.md", "source_location": "Tier C", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Original bug: summary generation used only the RSS teaser description, truncated further in Kotlin to 1200 chars, so the model 'summarised a summary'. Fix extracts full article body first via ArticleExtractor/SummarySource (6000-char cap) and does two Kotlin passes (read then write) so bullets appear only for multi-point articles."}, {"id": "gemininanoplugin_kt", "label": "GeminiNanoPlugin.kt (android native)", "file_type": "code", "source_file": "files/PROMPT-UX-PASS-01.md", "source_location": "C2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "article_summary_sheet_dart", "label": "article_summary_sheet.dart", "file_type": "code", "source_file": "files/PROMPT-UX-PASS-01.md", "source_location": "Tier C", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "article_extractor_dart", "label": "ArticleExtractor (article_extractor.dart)", "file_type": "code", "source_file": "files/PROMPT-UX-PASS-01.md", "source_location": "C1", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "files_prompt_ux_pass_01", "target": "files_pack_readme", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "files/PROMPT-UX-PASS-01.md", "source_location": null, "weight": 1.0}, {"source": "files_prompt_ux_pass_01", "target": "ux_pass_01_unread_counts_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "files/PROMPT-UX-PASS-01.md", "source_location": "A1", "weight": 1.0}, {"source": "files_prompt_ux_pass_01", "target": "ux_pass_01_loading_controller", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "files/PROMPT-UX-PASS-01.md", "source_location": "A2", "weight": 1.0}, {"source": "files_prompt_ux_pass_01", "target": "ux_pass_01_resume_refresh_policy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "files/PROMPT-UX-PASS-01.md", "source_location": "A3", "weight": 1.0}, {"source": "files_prompt_ux_pass_01", "target": "ux_pass_01_summary_source", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "files/PROMPT-UX-PASS-01.md", "source_location": "A4", "weight": 1.0}, {"source": "files_prompt_ux_pass_01", "target": "ux_pass_01_cross_tab_unread_counts_live", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "files/PROMPT-UX-PASS-01.md", "source_location": "B1", "