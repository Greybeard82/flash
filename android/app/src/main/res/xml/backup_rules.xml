<?xml version="1.0" encoding="utf-8"?>
<!--
    Android Auto Backup rules (API 23–30).
    Backs up the Flash SQLite database to the user's Google account.
    Restored automatically on reinstall — no user action required.
-->
<full-backup-content>
    <!-- Include the main database file -->
    <include domain="database" path="flash.db"/>
    <!-- Exclude WAL/SHM journal files — Android recreates these on open -->
    <exclude domain="database" path="flash.db-wal"/>
    <exclude domain="database" path="flash.db-shm"/>
</full-backup-content>
