<?xml version="1.0" encoding="utf-8"?>
<!--
    Android Auto Backup + device transfer rules (API 31+).
    Both cloud backup and device-to-device transfer include the Flash DB.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="flash.db"/>
        <exclude domain="database" path="flash.db-wal"/>
        <exclude domain="database" path="flash.db-shm"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="flash.db"/>
        <exclude domain="database" path="flash.db-wal"/>
        <exclude domain="database" path="flash.db-shm"/>
    </device-transfer>
</data-extraction-rules>
