<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Matches `darkBg` in lib/theme/app_theme.dart and NormalTheme's
         windowBackground, which is already this colour in both day and night.
         MainActivity replaces it at runtime with the app's active theme. -->
    <color name="window_background">#0D1B2A</color>
    <!-- 1x1 unread-count widget. Day values; res/values-night/colors.xml holds
         the dark pair. Both the background drawable and the number read these,
         so the two can never end up resolved against different configurations
         the way a hand-branched provider and a -night drawable could. -->
    <color name="widget_unread_bg">#F2F1EE</color>
    <color name="widget_unread_text">#E07A1F</color>
</resources>
